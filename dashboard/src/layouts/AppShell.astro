---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { mockData } from '../lib/api/mock';
import CommandPalette from '../components/CommandPalette.tsx';
import ConnectionBanner from '../components/ConnectionBanner.tsx';
import RealDashboard from '../components/RealDashboard.tsx';
const { title, section, crumb }=Astro.props as {title:string;section:string;crumb?:string};
const real = import.meta.env.PUBLIC_API_ADAPTER === 'real';
const nav=[['Overview','/','board-20-regular'],['Projects','/projects','folder-20-regular'],['Jobs','/jobs','task-list-ltr-20-regular'],['Approvals','/approvals','approvals-app-20-regular'],['Runs','/runs','bot-20-regular'],['Analytics','/analytics','data-area-20-regular'],['Providers','/providers','plug-connected-20-regular'],['Resources','/resources','document-multiple-20-regular'],['Settings','/settings','settings-20-regular'],['License','/license','key-20-regular']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content="Turtle Flow operational dashboard"/><link rel="icon" href="/assets/turtle-flow-icon-32.png" sizes="32x32"/><link rel="preload" href="/fonts/asap-sharp-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin/><script is:inline src="/theme.js"></script><script is:inline src="/palette-bridge.js"></script><title>{title} · Turtle Flow</title></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app"><aside class="sidebar" aria-label="Main navigation"><a class="brand" href="/"><img src="/assets/turtle-flow-logo.png" width="51" height="29" alt=""/><span>Turtle <span>Flow</span></span></a><nav class="sidebar-nav">{nav.map(([label,path,icon])=><a href={path} class="nav-link" aria-current={section===label?'page':undefined}><Icon name={`fluent:${icon}`}/><span>{label}</span>{!real&&label==='Approvals'&&<span class="nav-badge">{mockData.approvals.filter(a=>a.status==='pending').length}</span>}</a>)}</nav><div class="side-foot"><div><span class="dot"></span>{real ? "Local daemon" : "daemon connected · v0.3.0"}</div>{!real&&<div>License: <strong>Free</strong> · local</div>}</div></aside>
<div class="main"><header class="topbar"><button class="btn ghost menu-toggle" data-menu-toggle aria-label="Open navigation" aria-expanded="false">☰</button><div class="breadcrumbs">{crumb ? <><span class="muted">{section} / </span><strong>{crumb}</strong></> : <strong>{section}</strong>}</div><div class="topbar-actions"><select class="project-switcher" aria-label="Project switcher" data-project-switcher><option value="">All projects</option>{!real&&mockData.projects.map(p=><option value={p.slug}>{p.slug}</option>)}</select><button class="btn search-trigger" hidden={real} data-palette-open aria-label="Open command palette"><Icon name="fluent:search-20-regular"/><span>⌕ &nbsp; Search jobs, runs, resources…</span><span class="shortcut mono">⌘K</span></button><span class="topbar-live"><span class="dot"></span>Live</span><button type="button" class="btn ghost theme-toggle" data-theme-toggle aria-label="Toggle light and dark theme"><Icon name="fluent:dark-theme-20-regular"/></button></div></header><main id="main" class="content"><ConnectionBanner client:load/>{real ? <RealDashboard client:load section={section} /> : <slot />}</main></div></div>{!real&&<CommandPalette client:load/>}<script is:inline src="/shell.js"></script><script is:inline src="/copy.js"></script><script is:inline src="/project-switcher.js"></script></body></html>
