---
import AppShell from '../layouts/AppShell.astro';
import JobTable from '../components/JobTable.astro';
import BudgetMeter from '../components/BudgetMeter.astro';
import StatusBadge from '../components/StatusBadge.astro';
import LiveActivity from '../components/LiveActivity.tsx';
import QuickApprove from '../components/QuickApprove.tsx';
import {mockData} from '../lib/api/mock';
const {jobs,projects,approvals,providers}=mockData;
---
<AppShell title="Overview" section="Overview"><div class="page-title"><div><h1>Good morning</h1><p>3 approvals need you · 3 agents running · all within budget</p></div><div class="page-actions"><a class="btn" href="/jobs">View jobs</a><a class="btn primary" href="/projects/view?slug=payments-api">New job</a></div></div>
<div class="grid kpis"><div class="card kpi"><div class="kpi-label">Active jobs</div><div class="kpi-value">7</div><div class="kpi-sub">3 running · 2 waiting approval · 1 blocked</div></div><div class="card kpi"><div class="kpi-label">Pending approvals</div><div class="kpi-value warning">3</div><div class="kpi-sub">oldest waiting 42 min</div></div><div class="card kpi"><div class="kpi-label">Tokens this month <StatusBadge label="measured" tone="muted"/></div><div class="kpi-value">21.3M <small class="muted">/ 60M soft</small></div><div class="kpi-sub">35.5% of monthly envelope</div></div><div class="card kpi"><div class="kpi-label">Verified jobs · 30 days</div><div class="kpi-value success">18</div><div class="kpi-sub">≈ 690k tokens per verified job</div></div></div>
<div class="dashboard-grid"><div class="stack"><section class="card"><div class="card-head"><h2>Needs your attention</h2><small class="muted">3 approvals · 1 blocked</small></div>{approvals.map(approval=>{const job=jobs.find(j=>j.id===approval.job_id)!;return <div class="list-row"><div class="between"><StatusBadge label={approval.gate_kind.replaceAll('_',' ')} tone="warning"/><small class="muted">waiting {approval.id==='ap-42'?'42':approval.id==='ap-17'?'12':'6'} min</small></div><a href={`/approvals/view?id=${approval.id}`} class="text-primary mt-6">{job.key} · {job.title}</a><small>{approval.id==='ap-42'?'diff sha256:5d0c…e81a · 7 files · +295 −1':approval.id==='ap-8'?'+300k tokens · job at 1.1M of 1.2M':'spec rev 1 · est. 120k–310k'}</small>{approval.gate_kind==='scope'&&<QuickApprove client:load id={approval.id}/>}</div>})}</section><section class="card"><div class="card-head"><h2>Active jobs</h2><a href="/jobs"><small>View all</small></a></div><JobTable jobs={jobs} projects={projects}/></section></div><section class="card"><div class="card-head"><h2>Blocked</h2><StatusBadge label="1" tone="danger"/></div><div class="card-body"><a href="/jobs/view?id=WEB-12" class="mono">WEB-12</a><h3 class="text-16 mt-6">Fix flaky checkout e2e tests</h3><p class="muted" class="mt-10">Gate test failed after 3/3 fix iterations</p><pre class="notice mono" class="mt-10">✗ checkout.spec.ts › applies coupon<br/>✗ checkout.spec.ts › retries payment<br/>E_GATE_FIX_LIMIT · from build_test</pre><div class="page-actions" class="mt-12"><a class="btn small" href="/jobs/view?id=WEB-12">Resolve block</a><a class="btn small" href="/jobs/view?id=WEB-12">Open worktree</a></div></div></section><div class="stack"><LiveActivity client:load/><section class="card"><div class="card-head"><h2>Project budgets · October</h2><a href="/analytics"><small>Usage</small></a></div><div class="card-body stack" class="gap-12">{projects.map(project=><BudgetMeter budget={project.budget} compact>{project.slug}</BudgetMeter>)}</div></section><section class="card"><div class="card-head"><h2>Providers</h2><a href="/providers"><small>Manage</small></a></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th>Provider</th><th>Status</th><th>Running</th><th>Quota</th></tr></thead><tbody>{providers.map(provider=><tr><td>{provider.name}</td><td><StatusBadge label={provider.status.replace('_',' ')} tone={provider.status==='healthy'?'success':'warning'}/></td><td>{provider.running}</td><td>{provider.quota??'unknown'}</td></tr>)}</tbody></table></div></section></div></div>
</AppShell>
