---
import AppShell from '../../layouts/AppShell.astro';
import BudgetMeter from '../../components/BudgetMeter.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {mockData} from '../../lib/api/mock';
---
<AppShell title="Projects" section="Projects"><div class="page-title"><div><h1>Projects</h1><p>Repositories connected to Turtle Flow</p></div><a class="btn primary" href="/projects/view?slug=payments-api">+ Add project</a></div><div class="toolbar"><input class="input" data-table-filter="projects-table" aria-label="Search projects" placeholder="Search projects…"/><select class="select" data-table-select="projects-table" aria-label="Filter project status"><option>All statuses</option><option>Active</option><option>Archived</option></select><button class="btn" data-csv="projects-table">Export CSV</button></div><div class="card table-scroll"><table class="data-table" id="projects-table"><thead><tr><th>Project</th><th>Repository</th><th>Stack</th><th>Active jobs</th><th>Approvals</th><th class="min-260">Month tokens / budget</th><th>Gate pass</th><th>Last delivery</th><th>Health</th></tr></thead><tbody>{mockData.projects.map(p=><tr><td><a href={`/projects/view?slug=${p.slug}`}><strong>{p.name}</strong><br/><span class="mono muted">{p.slug}</span></a></td><td class="mono muted">{p.repo_path}</td><td>Rust · TypeScript</td><td>{p.active_jobs}</td><td>{p.pending_approvals}</td><td><BudgetMeter budget={p.budget} compact/></td><td>{p.gate_pass_rate}%</td><td>{p.last_delivery}</td><td><StatusBadge label={p.health} tone={p.health==='healthy'?'success':'warning'}/></td></tr>)}</tbody></table></div><div class="notice" class="mt-16"><strong>Add a repository</strong><p>Run <code>turtle project add &lt;path&gt;</code> from your terminal. The dashboard will show the new project after discovery.</p></div><script is:inline src="/tables.js"></script></AppShell>
