---
import AppShell from '../layouts/AppShell.astro';
import JobTable from '../components/JobTable.astro';
import {mockData} from '../lib/api/mock';
---
<AppShell title="Analytics" section="Analytics"><div class="page-title"><div><h1>Token usage & cost</h1><p>Understand where tokens go and how estimates compare with measured use.</p></div><button class="btn">Export CSV</button></div><div class="toolbar"><select class="select" aria-label="Period"><option>Last 30 days</option><option>Last 7 days</option><option>This month</option></select><select class="select" aria-label="Project"><option>All projects</option>{mockData.projects.map(p=><option>{p.slug}</option>)}</select><select class="select" aria-label="Provider"><option>All providers</option><option>Codex</option><option>Claude Code</option></select><select class="select" aria-label="Billing mode"><option>All billing modes</option><option>API equivalent</option><option>Subscription</option></select></div><div class="grid kpis"><div class="card kpi"><div class="kpi-label">Total tokens</div><div class="kpi-value">21.3M</div><div class="kpi-sub">20.9M measured · ≈0.4M estimated</div></div><div class="card kpi"><div class="kpi-label">API-equivalent cost</div><div class="kpi-value">$83.42</div><div class="kpi-sub">Actual billed amount unknown</div></div><div class="card kpi"><div class="kpi-label">Cost per verified job</div><div class="kpi-value">$4.63</div><div class="kpi-sub">18 verified jobs</div></div><div class="card kpi"><div class="kpi-label">Estimate coverage</div><div class="kpi-value">92%</div><div class="kpi-sub">P10–P90 interval available</div></div></div><div class="two-col"><div class="stack"><section class="card"><div class="card-head"><h2>Usage over time</h2><span class="muted">October · stacked by provider</span></div><div class="card-body chart-bars">{[['Oct 19',56],['Oct 20',74],['Oct 21',42],['Oct 22',91],['Oct 23',68],['Oct 24',82],['Oct 25',65]].map(([day,width])=><div class="chart-row"><span>{day}</span><div class="chart-bar"><svg viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true"><rect width={width} height="16" fill="var(--accent)" /></svg></div><span>{width}0k</span></div>)}</div></section><section class="card"><div class="card-head"><h2>Top jobs by tokens</h2></div><JobTable jobs={[...mockData.jobs].sort((a,b)=>(b.usage.total??0)-(a.usage.total??0)).slice(0,5)} projects={mockData.projects}/></section></div><div class="stack"><section class="card"><div class="card-head"><h2>By agent role</h2></div><div class="card-body chart-bars"><div class="chart-row"><span>Implementer</span><div class="chart-bar"><i></i></div><span>58%</span></div><div class="chart-row"><span>Reviewer</span><div class="chart-bar"><i class="ai"></i></div><span>19%</span></div><div class="chart-row"><span>Verifier</span><div class="chart-bar"><i class="warning"></i></div><span>13%</span></div><div class="chart-row"><span>Other</span><div class="chart-bar"><i></i></div><span>10%</span></div></div></section><section class="card"><div class="card-head"><h2>Estimate accuracy</h2></div><div class="card-body"><p class="muted">Actual use for 14 of 18 completed jobs fell within the P10–P90 range.</p><div class="kpi-value accent">78%</div><p class="muted">Interval coverage · measured runs only</p></div></section><section class="card"><div class="card-head"><h2>Cache efficiency</h2></div><div class="card-body"><div class="kpi-value">31%</div><p class="muted">Cache-read share of input tokens</p></div></section></div></div></AppShell>
