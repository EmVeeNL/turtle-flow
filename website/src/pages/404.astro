---
import { Image } from 'astro:assets';
import logo from '../assets/turtle-flow-logo.png';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Turtle Flow" description="This page does not exist.">
  <main class="mx-auto flex min-h-svh max-w-[1280px] flex-col justify-center px-6 lg:px-10">
    <Image src={logo} alt="" width={320} format="webp" class="mb-8 h-auto w-40" />
    <h1 class="text-[clamp(2.2rem,5vw,3.5rem)] leading-tight font-[650] tracking-[-0.03em]">
      Nothing here yet.
    </h1>
    <p class="mt-4 max-w-[30rem] text-lg text-muted">
      Turtle Flow is still in development. The only page so far is the
      <a href="/">front page</a>.
    </p>
  </main>
</Base>
