{
  // Static site served by Workers Static Assets, behind a tiny Worker that redirects www to the
  // bare domain. Build first: pnpm build.
  "name": "turtle-flow-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "turtle-flow.com", "custom_domain": true },
    { "pattern": "www.turtle-flow.com", "custom_domain": true }
  ]
}
