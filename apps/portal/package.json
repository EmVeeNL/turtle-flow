{
  "name": "@turtle-flow/portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:schema": "auth generate --config src/server/auth.codegen.ts --adapter drizzle --dialect postgresql --output src/server/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint --config .oxlintrc.json src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.18",
    "@fontsource-variable/asap-sharp": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify-json/fluent": "^1.2.61",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unplugin-icons": "^24.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@shadcn/lint": "^0.2.5",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "auth": "^1.7.18",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.92.0",
    "shadcn": "^4.22.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
