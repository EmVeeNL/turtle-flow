---
import AppShell from '../../layouts/AppShell.astro';
import {mockData} from '../../lib/api/mock';
import StatusBadge from '../../components/StatusBadge.astro';
---
<AppShell title="Approvals" section="Approvals"><div class="page-title"><div><h1>Approvals</h1><p>Approvals bind to exact artifact hashes. Any material change invalidates them.</p></div><div class="page-actions"><StatusBadge label="Pending (3)" tone="warning"/><button class="btn">History</button></div></div><div class="card"><div class="card-head"><h2>Pending decisions</h2><span class="muted">Oldest first</span></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th>Gate</th><th>Job</th><th>What is bound</th><th>Flags</th><th>Waiting</th><th></th></tr></thead><tbody>{mockData.approvals.map((approval,index)=>{const job=mockData.jobs.find(j=>j.id===approval.job_id)!;return <tr><td><StatusBadge label={approval.gate_kind.replaceAll('_',' ')} tone="warning"/></td><td><a href={`/jobs/view?id=${job.key}`} class="mono">{job.key}</a> · {job.title}</td><td class="mono muted">{approval.subject_hash.slice(0,18)}…</td><td>{approval.flags.length}</td><td>{[42,12,6][index]} min</td><td><a class="btn small" href={`/approvals/view?id=${approval.id}`}>Review →</a></td></tr>})}</tbody></table></div></div><div class="notice" class="mt-16">The approval screen shows the subject hash, changed files, budget envelope, and every invalidation condition before a decision.</div></AppShell>
