---
import AppShell from '../../layouts/AppShell.astro';
import LiveLog from '../../components/LiveLog.tsx';
import QueryIdentity from '../../components/QueryIdentity.tsx';
import {mockData} from '../../lib/api/mock';
import {formatUsage} from '../../lib/format';
const run=mockData.runs[2]!;
---
<AppShell title="Run detail" section="Runs" crumb="Run detail"><QueryIdentity client:load kind="run"/><div data-default-detail><div class="page-title"><div><h1>{run.id} · {run.role}</h1><p>API-44 · {run.provider} / {run.model} · CLI {run.cli_version}</p></div><div class="page-actions"><span class="pill ai">Running</span><button class="btn">Copy invocation</button><button class="btn">Download transcript</button></div></div><nav class="tabs" aria-label="Run detail sections"><a class="tab active" href="#transcript">Transcript</a><a class="tab" href="#manifest">Context manifest</a><a class="tab" href="#usage">Usage</a><a class="tab" href="#files">Changed files</a></nav><div class="two-col"><div class="stack"><section class="card" id="transcript"><LiveLog client:load runId={run.id}/></section><section class="card" id="manifest"><div class="card-head"><h2>Context manifest</h2><span class="muted">sha256:54f1…c2de</span></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th>Item</th><th>Source</th><th>Trust</th><th>Reason</th><th>≈ Tokens</th></tr></thead><tbody><tr><td>API contracts v2</td><td>resource v3</td><td>trusted</td><td>Relevant to refund routes</td><td>≈12k</td></tr><tr><td>Implementation task</td><td>plan rev 2</td><td>internal</td><td>Task instruction</td><td>≈5k</td></tr><tr><td>Recent diff</td><td>worktree</td><td>internal</td><td>Current state</td><td>≈27k</td></tr></tbody></table></div></section></div><div class="stack"><section class="card"><div class="card-head"><h2>Routing decision</h2></div><div class="card-body"><strong>{run.provider} / {run.model}</strong><p class="muted">{run.routing_reason}</p><div class="list-row">Capability match <span class="success">✓</span></div><div class="list-row">Tier preference <span class="success">✓</span></div></div></section><section class="card" id="usage"><div class="card-head"><h2>Usage</h2></div><div class="card-body"><div class="kpi-value">{formatUsage(run.usage)}</div><p class="muted">Reported by provider</p></div><table class="key-values"><tbody>{Object.entries(run.usage).filter(([key])=>!['total','provenance'].includes(key)).map(([key,value])=><tr><th>{key}</th><td class="mono">{Number(value).toLocaleString()}</td></tr>)}</tbody></table></section><section class="card" id="files"><div class="card-head"><h2>Changed files</h2></div><div class="list-row">crates/api/src/refund.rs</div><div class="list-row">crates/api/migrations/20261025_idempotency.sql</div></section></div></div></div></AppShell>
