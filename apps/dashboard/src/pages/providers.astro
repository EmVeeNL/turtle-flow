---
import AppShell from '../layouts/AppShell.astro';
import StatusBadge from '../components/StatusBadge.astro';
import {mockData} from '../lib/api/mock';
---
<AppShell title="Providers" section="Providers"><div class="page-title"><div><h1>Providers & models</h1><p>Inspect discovered CLIs, capabilities, routing, and price provenance.</p></div><div class="page-actions"><button class="btn">Refresh discovery</button><button class="btn primary">Run self-test</button></div></div><div class="grid kpis" class="two-kpis">{mockData.providers.map(provider=><section class="card kpi"><div class="page-actions"><h2>{provider.name}</h2><StatusBadge label={provider.status.replace('_',' ')} tone={provider.status==='healthy'?'success':'warning'}/></div><p class="muted">CLI {provider.version} · {provider.model}</p><div class="kpi-value">{provider.running}</div><div class="kpi-sub">running slots · quota {provider.quota??'unknown'}</div></section>)}</div><div class="two-col"><div class="stack"><section class="card"><div class="card-head"><h2>Capability matrix</h2></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th>Capability</th>{mockData.providers.map(p=><th>{p.name}</th>)}</tr></thead><tbody>{Object.keys(mockData.providers[0]!.capabilities).map(key=><tr><td>{key}</td>{mockData.providers.map(p=><td><StatusBadge label={p.capabilities[key]??'unknown'} tone={p.capabilities[key]==='known'?'success':'unknown'}/></td>)}</tr>)}</tbody></table></div></section><section class="card"><div class="card-head"><h2>Model prices</h2><button class="btn small">Edit price table</button></div><div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th>Provider</th><th>Model</th><th>Tier</th><th>Context</th><th>Price / 1M</th><th>Enabled</th></tr></thead><tbody>{mockData.providers.map(p=><tr><td>{p.name}</td><td class="mono">{p.model}</td><td>Standard</td><td>200k</td><td>{p.price_per_million==null?<span class="pill unknown">unknown</span>:`$${p.price_per_million.toFixed(2)}`}</td><td>Yes</td></tr>)}</tbody></table></div></section></div><div class="stack"><section class="card"><div class="card-head"><h2>Routing preferences</h2></div><div class="list-row">Implementer → Codex · standard</div><div class="list-row">Reviewer → Claude Code · standard</div><div class="list-row">Verifier → Claude Code · standard</div></section><section class="card"><div class="card-head"><h2>Rate-limit history</h2></div><div class="list-row"><span class="pill warning">Codex rate limited</span><small>Today 09:13 · next retry 09:31</small></div></section></div></div></AppShell>
