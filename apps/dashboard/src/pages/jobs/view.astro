---
import AppShell from '../../layouts/AppShell.astro';
import StageStepper from '../../components/StageStepper.astro';
import EstimateBar from '../../components/EstimateBar.astro';
import BudgetMeter from '../../components/BudgetMeter.astro';
import HashChip from '../../components/HashChip.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import QueryIdentity from '../../components/QueryIdentity.tsx';
import {mockData} from '../../lib/api/mock';
import {formatUsage} from '../../lib/format';
import {currentTasks,taskDetail,taskProgress,taskTone} from '../../lib/tasks';
const job=mockData.jobs[0]!;const project=mockData.projects[0]!;const tasks=currentTasks(mockData.tasks.filter(t=>t.job_id===job.id));
---
<AppShell title="Job detail" section="Jobs" crumb="Job detail"><QueryIdentity client:load kind="job"/><div data-default-detail><div class="page-title"><div><div class="page-actions"><span class="mono accent">{job.key}</span><StatusBadge label="Acceptance approval" tone="warning"/><span class="muted">standard profile</span></div><h1>{job.title}</h1><p>{project.slug} · {job.type} · started 2h 14m ago</p></div><div class="page-actions"><a class="btn" href={`/jobs/review?id=${job.key}`}>Open review</a><button class="btn desktop-only">Pause</button><a class="btn primary" href="/approvals/view?id=ap-42">Review approval</a></div></div><section class="card"><div class="card-head"><h2>Workflow</h2><span class="muted">8 of 9 stages</span></div><StageStepper index={8}/></section><div class="dashboard-grid job-grid" class="mt-16"><div class="stack"><section class="card"><div class="card-head"><h2>Timeline & audit events</h2></div>{mockData.events.filter(e=>e.job_id===job.id).map(e=><div class="event"><time>{e.occurred_at.slice(11,19)}</time><span class="event-dot"></span><div><strong>{e.payload.summary}</strong><p>{e.type} · {e.actor_kind} · {e.actor_id}</p></div></div>)}<div class="event"><time>08:33:00</time><span class="event-dot gate"></span><div><strong>Acceptance approval requested</strong><p>Subject hash bound to diff, verification and policy v4</p></div></div><div class="event"><time>08:31:00</time><span class="event-dot gate"></span><div><strong>Verification completed</strong><p>6/6 criteria met · rev 1</p></div></div></section><section class="card"><div class="card-head"><h2>Quality gates</h2></div><div class="card-body page-actions"><StatusBadge label="Build passed" tone="success"/><StatusBadge label="412 tests passed" tone="success"/><StatusBadge label="Lint passed" tone="success"/><StatusBadge label="Secret scan passed" tone="success"/></div></section></div><div class="stack"><section class="card"><div class="card-head"><h2>Tasks</h2><span class="muted">{taskProgress(tasks)}</span></div>{tasks.map(task=><div class="list-row"><div class="page-actions"><StatusBadge label={task.state} tone={taskTone(task.state)}/><strong>{task.plan_task_id}. {task.title}</strong></div><small>{taskDetail(task)}</small></div>)}</section><section class="card"><div class="card-head"><h2>Artifacts</h2><a href="/jobs/review?id=API-42">Open diff</a></div>{mockData.artifacts.map(artifact=><div class="list-row"><div class="page-actions"><strong>{artifact.kind.replaceAll('_',' ')}</strong><span class="muted">rev {artifact.rev}</span></div><small>{artifact.summary}</small><HashChip hash={artifact.sha256}/></div>)}</section></div><div class="stack"><section class="card"><div class="card-head"><h2>Tokens & estimate</h2></div><div class="card-body"><div class="kpi-value">{formatUsage(job.usage)}</div><p class="muted">Measured · across all agent runs</p><EstimateBar estimate={job.estimate}/></div></section><section class="card"><div class="card-head"><h2>Job budget</h2></div><div class="card-body"><BudgetMeter budget={{id:'job-budget',settled:612000,reserved:88000,limit:1140000,kind:'hard'}}/></div></section><section class="card"><div class="card-head"><h2>Approval binding</h2></div><div class="card-body"><StatusBadge label="Pending acceptance" tone="warning"/><p class="muted" class="mt-10">Subject hash</p><HashChip hash={mockData.approvals[0]!.subject_hash}/><p class="mt-12"><a href="/approvals/view?id=ap-42">Review exact binding →</a></p></div></section></div></div></div></AppShell>
