---
import AppShell from '../layouts/AppShell.astro';
import StatusBadge from '../components/StatusBadge.astro';
import HashChip from '../components/HashChip.astro';
import {mockData} from '../lib/api/mock';
---
<AppShell title="Resources" section="Resources"><div class="page-title"><div><h1>Resources</h1><p>Versioned reference material supplied to agents only when relevant.</p></div><button class="btn primary">Add resource</button></div><div class="toolbar"><input class="input" data-table-filter="resources-table" aria-label="Search resources" placeholder="Search resources…"/><select class="select" data-table-select="resources-table" aria-label="Trust level"><option>All trust levels</option><option>Trusted</option><option>Internal</option><option>Untrusted</option></select></div><div class="two-col"><div class="card table-scroll"><table class="data-table" id="resources-table"><thead><tr><th>Resource</th><th>Kind</th><th>Trust</th><th>Version</th><th>Attached to</th><th>Size</th><th>Extraction</th></tr></thead><tbody>{mockData.resources.map(resource=><tr><td><a href={`#${resource.id}`}>{resource.title}</a></td><td>{resource.kind.replace('_',' ')}</td><td><StatusBadge label={resource.trust} tone={resource.trust==='trusted'?'success':resource.trust==='untrusted'?'warning':'muted'}/></td><td>v{resource.versions.at(-1)?.version}</td><td>{resource.attached_to.join(', ')}</td><td>{resource.size}</td><td><StatusBadge label={resource.versions.at(-1)?.status??'unknown'} tone={resource.versions.at(-1)?.status==='ready'?'success':'danger'}/></td></tr>)}</tbody></table></div><div class="stack">{mockData.resources.map(resource=><section class="card" id={resource.id}><div class="card-head"><h2>{resource.title}</h2><span class="muted">v{resource.versions.at(-1)?.version}</span></div><div class="card-body"><p class="muted">{resource.kind.replace('_',' ')} · {resource.trust} · used in {resource.used_in} context packages</p><p>Attached to: {resource.attached_to.join(', ')}</p><p class="muted">Content hash</p><HashChip hash={resource.versions.at(-1)!.sha256}/>{resource.versions.at(-1)?.status==='failed'&&<div class="notice warning">No text extracted; OCR is not supported in this version.</div>}</div></section>)}</div></div><script is:inline src="/tables.js"></script></AppShell>
