---
import AppShell from '../../layouts/AppShell.astro';
import JobTable from '../../components/JobTable.astro';
import BudgetMeter from '../../components/BudgetMeter.astro';
import QueryIdentity from '../../components/QueryIdentity.tsx';
import {mockData} from '../../lib/api/mock';
const project=mockData.projects[0]!;
---
<AppShell title="Project detail" section="Projects" crumb="Project detail"><QueryIdentity client:load kind="project"/><div data-default-detail><div class="page-title"><div><h1>{project.name}</h1><p>{project.repo_path} · {project.default_branch} · standard profile</p></div><div class="page-actions"><span class="pill success">Healthy</span><button class="btn">Run doctor</button><button class="btn primary">Create job</button></div></div><nav class="tabs" aria-label="Project sections"><a class="tab active" href="#jobs">Jobs</a><a class="tab" href="#resources">Resources</a><a class="tab" href="#knowledge">Knowledge</a><a class="tab" href="#budget">Budgets</a><a class="tab" href="#history">History</a></nav><div class="two-col"><div class="stack"><section class="card" id="jobs"><div class="card-head"><h2>Jobs</h2><span class="muted">3 active</span></div><JobTable jobs={mockData.jobs.filter(j=>j.project_id===project.id)} projects={mockData.projects}/></section><section class="card" id="resources"><div class="card-head"><h2>Attached resources</h2><a href="/resources">Manage resources</a></div>{mockData.resources.filter(r=>r.attached_to.includes(project.slug)).map(r=><div class="list-row"><strong>{r.title}</strong><small>{r.trust} · v{r.versions.at(-1)?.version} · used in {r.used_in} context packages</small></div>)}</section><section class="card" id="knowledge"><div class="card-head"><h2>Knowledge</h2><span class="pill warning">1 stale</span></div><div class="list-row"><strong>API middleware conventions</strong><small>active · verified at a81d77e</small></div><div class="list-row"><strong>Retry policy for external clients</strong><small>stale · source files changed since last verification</small></div></section></div><div class="stack"><section class="card" id="budget"><div class="card-head"><h2>Budget · October</h2></div><div class="card-body"><BudgetMeter budget={project.budget}/></div></section><section class="card"><div class="card-head"><h2>Quality gates</h2></div><div class="card-body"><div class="kpi-value success">98%</div><p class="muted">Pass rate over the last 30 days</p><div class="list-row">build <span class="success">✓ last passed</span></div><div class="list-row">test <span class="success">✓ 412 passed</span></div><div class="list-row">lint <span class="success">✓ last passed</span></div></div></section><section class="card" id="history"><div class="card-head"><h2>History</h2></div><div class="list-row">API-42 entered acceptance approval <small>Today 08:33</small></div><div class="list-row">API-44 implementation started <small>Today 08:27</small></div></section></div></div></div></AppShell>
