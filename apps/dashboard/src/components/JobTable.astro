---
import type {Job,Project} from '../lib/api/types';
import {formatUsage} from '../lib/format';
import StageStepper from './StageStepper.astro';
import StatusBadge from './StatusBadge.astro';
const {jobs,projects}=Astro.props as {jobs:Job[];projects:Project[]};
const tone=(state:string)=>state==='blocked'?'danger':state.includes('approval')?'warning':state==='implementation'?'ai':state==='done'?'success':'muted';
---
<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table class="data-table"><thead><tr><th scope="col">Job</th><th scope="col">Title</th><th scope="col">Project</th><th scope="col">Progress</th><th scope="col">Stage</th><th scope="col">Provider</th><th scope="col" class="right">Tokens</th><th scope="col" class="right">Elapsed</th></tr></thead><tbody>
{jobs.map(job=><tr><td><a class="row-link" href={`/jobs/view?id=${encodeURIComponent(job.key)}`}>{job.key}</a></td><td>{job.title}</td><td class="muted">{projects.find(p=>p.id===job.project_id)?.slug}</td><td><StageStepper index={job.stage_index} small blocked={job.state==='blocked'}/></td><td><StatusBadge label={job.pause_status??(job.hold==='awaiting_budget'?'Awaiting budget':job.state.replaceAll('_',' '))} tone={tone(job.state)}/></td><td class="muted">{job.provider}</td><td class="right mono">{formatUsage(job.usage)}</td><td class="right muted">{job.elapsed}</td></tr>)}
</tbody></table></div>
