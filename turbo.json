{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_API_ADAPTER"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "check": { "dependsOn": ["^build"] },
    "lint": {},
    "test": {},
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
